{
  "name": "clientdesk-harness",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs",
    "typecheck": "npm run contract:check && tsc --noEmit",
    "contract:generate": "node scripts/check-contract.mjs --write",
    "contract:check": "node scripts/check-contract.mjs",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build:demo && npm run test:e2e && npm run scan:secrets"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.105.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "antd": "6.6.8",
    "msw": "2.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
